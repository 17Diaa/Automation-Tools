{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "functions": {
    "app.py": {
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/app.py" },
    { "src": "/instances/(.*)", "dest": "/app.py" },
    { "src": "/style.css", "dest": "/app.py" },
    { "src": "/(.*)", "dest": "/app.py" }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/15 * * * *"
    }
  ]
}
